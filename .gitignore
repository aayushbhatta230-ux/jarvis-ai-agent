# .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/

# Distribution
dist/
build/
*.egg-info/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Database
*.db
*.sqlite

# Cache
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment
.env
.env.local

# Temporary
*.tmp
*.temp
temp/

# Audio
*.wav
*.mp3
*.ogg

# Video
*.mp4
*.webm

# Images
*.png
*.jpg
*.jpeg
*.gif

# Portfolio/PWA artwork must stay tracked
!portfolio/og-image.png
!portfolio/*.png
!portfolio/*.jpg
!portfolio/*.svg

# Archives
*.zip
*.tar.gz
*.rar

# Node (if any)
node_modules/

# Coverage
htmlcov/
.coverage

# JARVIS specific
tts_cache/
latest_screenshot.png
recordings/
database/
config/settings.json

# Runtime state written by the assistant (machine-local, never shared)
memory/*.json
!memory/.gitkeep

# Tunnel tooling and credentials
*.exe
*.exe.old
config/tunnel_token.txt
config/tunnel_url.txt
config/permanent_url.txt
config/ngrok_domain.txt
.ngrok/

# One-off development scripts left in the repo root
/fix_*.py
/_fix_*.py
/_diag.py
/_probe.py
/_probe_*.py
/_fix_*.py
